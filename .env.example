# Environment Configuration Example
SECRET_KEY=generate-a-secure-random-secret-key-here

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# Or Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
#
# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/calendar/oauth/callback
# Optional: defaults to Google's read-only Calendar scope
GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.readonly
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
